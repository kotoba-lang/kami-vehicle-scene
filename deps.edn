{:paths ["src" "resources"]
 :deps {gftd/scene {:git/url "https://github.com/kotoba-lang/scene.git"
                     :sha "b0ca0ba9134dc8e57ebcb1d82d51829456d8b703"}
        io.github.kotoba-lang/physics
        {:git/url "https://github.com/kotoba-lang/physics.git"
         :git/sha "3081560a4327319d9916a3c1c53471223462c0c3"}
        io.github.kotoba-lang/kami-vehicle
        {:git/url "https://github.com/kotoba-lang/kami-vehicle.git"
         :git/sha "9a3c3cbfee195692d6dbd23a2b6891f991483d00"}}
 :aliases {:test {:extra-paths ["test"]
